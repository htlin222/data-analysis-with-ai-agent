[193.075983, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;23r\u001b[1S\u001b[r\u001b[H\u001b[3G\u001b[1mC. 跨檔案問題\r\u001b[4C\u001b[21B建議\u001b[22m：\u001b[38;2;177;185;249mreadr::read_csv()\u001b[29G\u001b[39m兩者都能正確處理；但別用\u001b[54G\u001b[38;2;177;185;249mawk -F,\u001b[62G\u001b[39m/\u001b[64G\u001b[38;2;177;185;249mcut -d,\u001b[72G\u001b[39m手動切欄。\u001b[30;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
[193.341225, "o", "\u001b]0;◐ raw/ 底下 CSV 資料品質檢查\u0007"]
[193.78189, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;23r\u001b[8S\u001b[r\u001b[H\u001b[3G  在語法層就不可能發生。這是這批資料最容易出事的地方。\r\u001b[2C\u001b[15B\u001b[1m✅ 沒問題的部分\r\u001b[2C\u001b[2B\u001b[22m兩檔皆為\u001b[12GUTF-8/ASCII、LF\u001b[28G換行、無\u001b[37GBOM、無缺失值、\u001b[38;2;177;185;249mpatient_id\u001b[63G\u001b[39m無重複。\r\u001b[2C\u001b[2B---\r\u001b[2C\u001b[2B\u001b[1m總結\u001b[22m\u001b[30;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
