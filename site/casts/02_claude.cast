[184.503362, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;23r\u001b[3S\u001b[r\u001b[H\u001b[5G\u001b[1mIII–IV\u001b[12G\u001b[22m兩層再進 Cox 模型。\u001b[K\r\u001b[4C\u001b[19B\u001b[1m問題\u001b[22m：Drug_A\u001b[18G52\u001b[21G人\u001b[24G/\u001b[26GDrug_B\u001b[33G48\u001b[36G人；stage\u001b[46GI\u001b[48G在\u001b[51GDrug_A\u001b[58G有\u001b[61G11\u001b[64G人、Drug_B\u001b[75G只有\u001b[80G6\u001b[82G人。\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m影響\u001b[22m：全部\u001b[16G100\u001b[20G筆。\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m建議\u001b[22m：不要只做\u001b[20Glog-rank，用\u001b[33GCox\u001b[37G校正\u001b[42G\u001b[38;2;177;185;249mage + gender + stage\u001b[39m。\u001b[30;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
