[380.262584, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;23r\u001b[2S\u001b[r\u001b[H\u001b[4G--\u001b[K\r\u001b[5C\u001b[20B加驗證：\u001b[38;2;177;185;249mstage\u001b[20G\u001b[39m只能有這四個值，出現其他值就報錯而不是靜默變\u001b[65G\u001b[38;2;177;185;249mNA\u001b[39m；並斷言\u001b[76G\u001b[38;2;177;185;249mstage_group\u001b[88G\u001b[39m無\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mNA\u001b[39m、\u001b[38;2;177;185;249mtable()\u001b[18G\u001b[39m結果為\u001b[25G49/51。\r\u001b[2C\u001b[1B4.\u001b[30;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
