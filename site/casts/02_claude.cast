[186.589204, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;23r\u001b[3S\u001b[r\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[20B\u001b[1m🔴 1. \u001b[38;2;177;185;249mpatient_id\u001b[39m 是假的共用鍵 — 合併會靜默出錯\r\u001b[2C\u001b[2B\u001b[22m-\u001b[30;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
[187.241074, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[4C\u001b[22B\u001b[1m問題\u001b[22m：兩檔\u001b[16G\u001b[38;2;177;185;249mpatient_id\u001b[27G\u001b[39m都是\u001b[32G1–100，join\u001b[44G起來會「成功」回傳\u001b[63G100\u001b[67G筆而\u001b[1m不報任何錯\u001b[22m。但我實測：同\u001b[96Gid\u001b[99G的\u001b[30;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
