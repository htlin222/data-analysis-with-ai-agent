[13.818839, "o", "\u001b(B\u000f\u001b[<u\u001b[>5u\u001b[>4;2m\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[2C\u001b[26B先不要做任何\r\u001b[51C\u001b[3B\u001b[K\u001b[30;1H\u001b[27;15H\u001b[?25h\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[14C\u001b[26B修改。請讀\u001b[26Graw/\u001b[31G底\u001b[30;1H\u001b[27;33H\u001b[?25h\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[32C\u001b[26B下的兩份主要\u001b[30;1H\u001b[27;45H\u001b[?25h\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[45C\u001b[26BCSV，用\u001b[30;1H\u001b[27;53H\u001b[?25h\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[52C\u001b[26B中文列出你發\u001b[30;1H\u001b[27;65H\u001b[?25h\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[64C\u001b[26B現的所有資料\u001b[30;1H\u001b[27;77H\u001b[?25h\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[76C\u001b[26B品質問題，每\u001b[30;1H\u001b[27;89H\u001b[?25h\u001b[?2026l\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[82C\u001b[23B\u001b[38;2;153;153;153m● high · /effort\r\u001b[1B\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m \u001b[38;2;255;120;20m↯\u001b[100G\u001b[38;2;136;136;136m"]
