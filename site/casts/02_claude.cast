[430.409902, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G-\u001b[5G二分變數\u001b[1m額外新增一欄\u001b[22m（\u001b[38;2;177;185;249mstage_group\u001b[39m），不覆蓋原本的\u001b[55G\u001b[38;2;177;185;249mstage\r\u001b[26C\u001b[21B\u001b[38;2;153;153;153mthought for 36s)\u001b[39m\u001b[K\u001b[30;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
[430.412403, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[19B\u001b[38;2;153;153;153m⏺\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[27G\u001b[38;2;153;153;153m↓\u001b[39m \u001b[38;2;153;153;153m38 tokens\u001b[39G· thought for 36s)\u001b[39m\u001b[30;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
[430.428248, "o", "\u001b[?2026h\u001b[?25l\u001b[H\r\u001b[28C\u001b[21B\u001b[38;2;153;153;153m63\u001b[39m\u001b[30;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
