[183.446301, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;23r\u001b[5S\u001b[r\u001b[H\u001b[5GDrug_A 僅 9 人、stage\u001b[27GI\u001b[29G×\u001b[31GDrug_B\u001b[38G僅\u001b[41G6\u001b[43G人。\r\u001b[4C\u001b[18Banalysis（如\u001b[18G1\u001b[20G個月）作為敏感度分析。\r\u001b[2C\u001b[2B\u001b[1m🟡 6. 基線不平衡\r\u001b[2C\u001b[2B\u001b[22m-\u001b[30;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
