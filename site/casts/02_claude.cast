[196.889652, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;23r\u001b[2S\u001b[r\u001b[H\u001b[3G- \u001b[1m問題\u001b[22m：\u001b[38;2;177;185;249mA\u001b[39m/\u001b[38;2;177;185;249mB\u001b[39m vs \u001b[38;2;177;185;249mDrug_A\u001b[39m/\u001b[38;2;177;185;249mDrug_B\u001b[39m。\r\u001b[2C\u001b[21B假鍵則是唯一會「靜默產生錯誤結果」的陷阱。\u001b[30;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
