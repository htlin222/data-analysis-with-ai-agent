[56.741237, "o", "\u001b[?25hCall: "]
[56.74128, "o", "survfit(formula = Surv(time, status) ~ treatment, data = cohort)\r\n\r\n"]
[56.741436, "o", "                  n events median 0.95LCL 0.95UCL"]
[56.741463, "o", "\r\ntreatment=Drug_A 52     36   17.5    12.1    27.9\r\ntreatment=Drug_B 48     33   17.7"]
[56.741484, "o", "     9.0    32.2\r\n"]
