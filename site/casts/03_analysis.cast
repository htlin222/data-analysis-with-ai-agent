[56.741543, "o", "\u001b[?25h"]
[56.859805, "o", "\u001b[?25h"]
[57.241835, "o", "\u001b[?25h"]
[57.246116, "o", "\u001b[?25h"]
[57.253018, "o", "\u001b[?25h\r\n== Cox model ==\r\n"]
[57.253032, "o", "\u001b[?25h"]
[57.253089, "o", "  世代 100 人 69 events；模型實際使用 96 人 66 events（age 缺失 4 筆整列排除）\r\n"]
[57.253141, "o", "\u001b[?25h"]
[57.253149, "o", "  EPV = 66 / 4 個共變項 = 16.5\r\n\u001b[?25h"]
[57.25375, "o", "             term    HR    95% CI        p\r\n              age 1.036 1.01-1.06 0.001260\r\n            sex男 0.960 0.57-1.63 0.880000\r\n stage_groupearly 0.404 0.24-0.67 0.000505\r\n  treatmentDrug_B 0.786 0.46-1.34 0.375000"]
[57.253757, "o", "\r\n"]
[57.253805, "o", "\u001b[?25h"]
[57.255453, "o", "\u001b[?25h"]
