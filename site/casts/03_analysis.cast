[28.424463, "o", "\u001b[?25h\r\n== Table 1 ==\r\n"]
[28.424486, "o", "\u001b[?25h"]
[28.510231, "o", "\u001b[38;5;246m# A tibble: 10 × 5\u001b[39m\r\n"]
[28.521216, "o", "   `**變項**`     `**N**` `**advanced**  \\nN = 51` `**early**  \\nN = 49`\r\n   \u001b[3m\u001b[38;5;246m<chr>\u001b[39m\u001b[23m          \u001b[3m\u001b[38;5;246m<chr>\u001b[39m\u001b[23m   \u001b[3m\u001b[38;5;246m<chr>\u001b[39m\u001b[23m                    \u001b[3m\u001b[38;5;246m<chr>\u001b[39m\u001b[23m                \r\n\u001b[38;5;250m 1\u001b[39m 年齡           96      56 (49-64)               59 (49-68)           \r\n\u001b[38;5;250m 2\u001b[39m Unknown        \u001b[31mNA\u001b[39m      3                        1                    \r\n\u001b[38;5;250m 3\u001b[39m 性別           100     \u001b[31mNA\u001b[39m                       \u001b[31mNA\u001b[39m                   \r\n\u001b[38;5;250m 4\u001b[39m 女             \u001b[31mNA\u001b[39m      26 (51%)                 22 (45%)             \r\n\u001b[38;5;250m 5\u001b[39m 男             \u001b[31mNA\u001b[39m      25 (49%)                 27 (55%)             \r\n\u001b[38;5;250m 6\u001b[39m 治療組         100     \u001b[31mNA\u001b[39m                       \u001b[31mNA\u001b[39m                   \r\n\u001b[38;5;250m 7\u001b[39m Drug_A         \u001b[31mNA\u001b[39m      25 (49%)                 27 (55%)             \r\n\u001b[38;5;250m 8\u001b[39m Drug_B         \u001b[31mNA\u001b[39m      26 "]
[28.521291, "o", "(51%)                 22 (45%)             \r\n\u001b[38;5;250m 9\u001b[39m 追蹤時間（月） 100     10 (4-26)                24 (7-36)            \r\n\u001b[38;5;250m10\u001b[39m 死亡           100     44 (86%)                 25 (51%)             \r\n   `**p-value**`\r\n   \u001b[3m\u001b[38;5;246m<chr>\u001b[39m\u001b[23m        \r\n\u001b[38;5;250m 1\u001b[39m 0.3          \r\n\u001b[38;5;250m 2\u001b[39m \u001b[31mNA\u001b[39m           \r\n\u001b[38;5;250m 3\u001b[39m 0.5          \r\n\u001b[38;5;250m 4\u001b[39m \u001b[31mNA\u001b[39m           \r\n\u001b[38;5;250m 5\u001b[39m \u001b[31mNA\u001b[39m           \r\n\u001b[38;5;250m 6\u001b[39m 0.5          \r\n\u001b[38;5;250m 7\u001b[39m \u001b[31mNA\u001b[39m           \r\n\u001b[38;5;250m 8\u001b[39m \u001b[31mNA\u001b[39m           \r\n\u001b[38;5;250m 9\u001b[39m 0.012        \r\n\u001b[38;5;250m10\u001b[39m <0.001       \r\n"]
