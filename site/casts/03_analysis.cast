[6.014706, "o", "\u001b[?25h"]
[6.014756, "o", "\r\n== 檢查一：缺失 ==\r\n\u001b[?25h"]
[6.015497, "o", "\u001b[?25h  "]
[6.015506, "o", " patient_id=0  age=4  sex=0  stage=0  treatment=0  time=0  status=0 \r\n"]
[6.015549, "o", "\u001b[?25h"]
[6.015591, "o", "  age 缺失 4 筆。不插補；Cox model 會整列排除，實際 n 因此低於 100。\r\n"]
[6.015621, "o", "\u001b[?25h"]
[6.015628, "o", "\r\n== 檢查二：範圍與邏輯 ==\r\n"]
[6.01566, "o", "\u001b[?25h"]
[6.015714, "o", "  age  : 31 - 81 歲\r\n"]
[6.015743, "o", "\u001b[?25h"]
[6.015764, "o", "  time : 0.5 - 36.0 個月\r\n"]
[6.015793, "o", "\u001b[?25h"]
[6.015847, "o", "\u001b[?25h"]
[6.015868, "o", "  通過：time 皆為正、status 僅 0/1\r\n"]
[6.015891, "o", "\u001b[?25h\r\n"]
[6.01591, "o", "== 檢查三：設限型態 ==\r\n"]
[6.015926, "o", "\u001b[?25h"]
[6.015962, "o", "\u001b[?25h"]
[6.016008, "o", "\u001b[?25h"]
[6.016027, "o", "  死亡 69　設限 31\r\n"]
[6.016055, "o", "\u001b[?25h"]
[6.016078, "o", "  設限中有 25 筆 time = 36（最長追蹤），屬行政設限\r\n"]
[6.016107, "o", "\u001b[?25h"]
[6.022655, "o", "\u001b[?25h"]
