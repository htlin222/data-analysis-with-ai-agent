# 產出可以隨時重生，不進版控。開頭的斜線限定只忽略根目錄下的同名資料夾，
# 否則 site/assets/figs/ 也會被一起忽略，投影片的圖就沒了。
/output/
/figs/
/Rplots.pdf
.Rhistory
.RData
.DS_Store
__pycache__/
*.pyc
.rec_bashrc
*.cast.part

# 全域 gitignore 有 vendor/，但站台的 asciinema-player 就放在那裡，
# 沒有它整個錄影頁都跑不起來。先解除目錄本身才能再解除內容。
!site/assets/vendor/
!site/assets/vendor/**

# Cloudflare Pages 的憑證。.env.example 要留著當範本，
# 所以 .env.* 之後必須再解除它，否則會被一起忽略。
.env
.env.*
!.env.example
.wrangler/

.dev.vars*
!.dev.vars.example
