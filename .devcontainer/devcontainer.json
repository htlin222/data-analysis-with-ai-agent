{
  "name": "data-analysis-with-ai-agent",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/rocker-org/devcontainer-features/r-apt:0": {
      "installBspm": true,
      "vscodeRSupport": "none"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "onCreateCommand": "curl -fsSL https://raw.githubusercontent.com/htlin222/dotfiles/main/start/codespace_prewarm.sh | bash",
  "updateContentCommand": "bash .devcontainer/install-r-packages.sh",
  "postCreateCommand": "bash .devcontainer/verify.sh",
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "eamodio.gitlens"]
    }
  },
  "hostRequirements": { "cpus": 2 }
}
